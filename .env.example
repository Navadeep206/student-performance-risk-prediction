# ==============================================================================
# Environment Configuration - Student At-Risk Prediction
# Copy this file to .env and adjust variables as needed for local development.
# ==============================================================================

# Application Environment (development, testing, production)
ENV=development

# Logging
LOG_LEVEL=INFO

# Reproducibility
RANDOM_SEED=42

# Storage & Paths (relative to project root or absolute paths)
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
MODELS_DIR=models
REPORTS_DIR=reports

# Serving / API Configuration (Phase 11)
APP_HOST=0.0.0.0
APP_PORT=8000

